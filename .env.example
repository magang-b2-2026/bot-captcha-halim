# ==============================================================
# KOMDIGI Bot Environment Configuration Template
# Copy this file to .env and configure your secrets.
# NEVER commit your actual .env file to version control.
# ==============================================================

# Primary LLM Endpoint (OpenAI-compatible inference gateway)
LLM_BASE_URL=http://localhost:20128/v1
LLM_API_KEY=your_primary_llm_api_key_here
LLM_MODEL_VISION=ag/gemini-3.8-flash-high
LLM_MODEL_REASONING=ag/gemini-3.8-flash-high

# Secondary LLM Fallback Providers (Optional: Google AI Studio / Vikey.ai)
LLM_FALLBACK_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
LLM_FALLBACK_API_KEY=
LLM_FALLBACK_MODEL_VISION=gemini-3.5-flash-lite
LLM_FALLBACK_MODEL_REASONING=gemini-3.5-flash-lite

# TypeSafe AI System One decision pre-gate (Optional but recommended)
TYPESAFE_API_KEY=

# Hybrid Residential Egress Proxy (SOCKS5/HTTP tunnel)
# Example: socks5://100.x.y.z:1080 or socks5://user:pass@proxy-host:port
PROXY=

# 2Captcha API Fallback for Heavy Commercial Families (Optional)
SOLVER_API_KEY_2CAPTCHA=
TWOCAPTCHA_API_KEY=

# Orchestrator & Scheduling Tuning
SOLVER_POLICY=hybrid
INTERVAL_SECONDS=1800
JITTER_SECONDS=180